#!/bin/bash
#SBATCH --job-name=qwen3_vl_inference
#SBATCH --output=qwen3_vl_inference%j.out
#SBATCH --error=qwen3_vl_inference%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:a40:1
#SBATCH --mem=32G
#SBATCH --time=48:00:00

cd "$(dirname "$0")"
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi

python qwen3_vl_inference.py --dataset cropped