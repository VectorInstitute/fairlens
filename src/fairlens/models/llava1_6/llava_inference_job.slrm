#!/bin/bash
#SBATCH --job-name=llava_inference
#SBATCH --output=llava_inference%j.out
#SBATCH --error=llava_inference%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:a100:1
#SBATCH --mem=32G
#SBATCH --time=72:00:00

cd "$(dirname "$0")"
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
fi

python llava.py --dataset cropped